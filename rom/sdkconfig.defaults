CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 串口：删掉 USB host 切换后，UART0 调试口与原生 USB-Serial/JTAG 都不再被 OTG 占用。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA 回滚：新固件先以 PENDING_VERIFY 启动，跑完健康检查才标记可用。
# 没通过就重启回上一槽——否则一版坏固件 = 一批砖。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA 固件签名放在 sdkconfig.release（需要签名私钥），不进默认配置：
# 开源硬件要保证 `idf.py build` 开箱即用。见 docs/PRODUCT.md 第 3 节。

# 崩溃取证：coredump 写 flash，事后 idf.py coredump-info 读回溯
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# 1080p MJPEG ~120KB/帧 × 2fps，加大 TCP 窗口提吞吐（probe 实测值）。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# MQTT TLS + 推流 + netlog + 配网 httpd，16 个 socket 是余量。
CONFIG_LWIP_MAX_SOCKETS=16

# Wi-Fi 缓冲保持低流量配置，把堆留给 MQTT TLS 和推流。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
# T8：推流 2fps 不需要 16 个动态 TX 缓冲，10 个实测不掉帧。
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# 一条 MQTT TLS 长连接常驻。DYNAMIC_BUFFER 让它在空闲时把收发缓冲还回去，
# 推流和配网时多出十几 KB。
#
# DYNAMIC_FREE_CONFIG_DATA 绝对不能开——esp-mqtt 复用同一份配置，第一次握手
# 成功后每次重连都会失败（真机踩过）。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# ── T8 内存压缩 ──
# LVGL 内置堆实测峰值 9.6KB；16KB 留足余量，省下约 48KB。
CONFIG_LV_MEM_SIZE_KILOBYTES=16
# 服务端只有 MQTT 小消息 + 约 3~4KB 证书链；8KB 足够，握手峰值省约 8KB。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
# esp_timer 任务实测余量 3.1KB，2048 仍留约 1.5KB。
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
# esp-mqtt 任务实测余量 3.4KB；4096 留约 1.4KB。收发缓冲按用量 payload 定 1KB。
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_TASK_STACK_SIZE=4096
CONFIG_MQTT_BUFFER_SIZE=1024
