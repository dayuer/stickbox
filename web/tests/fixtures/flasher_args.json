  },
  "bootloader": {
    "offset": "0x0",
    "bin": "bootloader/bootloader.bin"
  },
  "partition-table": {
    "offset": "0x8000",
    "bin": "partition_table/partition-table.bin"
  },
  "ota_data_initial": {
    "offset": "0xf000",
    "bin": "ota_data_initial.bin"
  },
  "extra_esptool_args": {
    "chip": "esp32s3"
  }
